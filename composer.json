{
  "name": "sidecar/craft-ga",
  "description": "Google Analytics 4 dashboard for Craft CMS",
  "type": "craft-plugin",
  "license": "MIT",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "google-analytics",
    "ga4",
    "search-console"
  ],
  "support": {
    "issues": "https://github.com/alexandreSideCar/craft-ga/issues",
    "source": "https://github.com/alexandreSideCar/craft-ga"
  },
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.3.0",
    "google/analytics-data": "^0.24",
    "google/apiclient": "^2.15",
    "google/apiclient-services": "^0.450"
  },
  "autoload": {
    "psr-4": {
      "sidecar\\craftga\\": "src/"
    }
  },
  "extra": {
    "handle": "craft-ga",
    "name": "Craft GA",
    "class": "sidecar\\craftga\\Plugin",
    "developer": "Side-Car",
    "craftcms-claude-skills": "1.2.0"
  }
}
