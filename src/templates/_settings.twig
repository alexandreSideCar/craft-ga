{% import '_includes/forms.twig' as forms %}

{{ forms.autosuggestField({
    label: 'GA4 Property ID'|t('craft-ga'),
    instructions: 'The numeric property ID from GA4 Admin > Property Settings (e.g. `properties/123456789`). Supports environment variables.'|t('craft-ga'),
    id: 'propertyId',
    name: 'propertyId',
    value: settings.propertyId,
    suggestEnvVars: true,
    required: true,
}) }}

<hr>

<h2>{{ 'Search Console'|t('craft-ga') }}</h2>

{{ forms.lightswitchField({
    label: 'Enable Search Console'|t('craft-ga'),
    instructions: 'Display Google Search Console data (queries, impressions, clicks, positions). Requires the Search Console API to be enabled in Google Cloud Console. You must reconnect your Google account after enabling this.'|t('craft-ga'),
    id: 'enableSearchConsole',
    name: 'enableSearchConsole',
    on: settings.enableSearchConsole,
}) }}

<div id="searchConsoleSettings" {% if not settings.enableSearchConsole %}class="hidden"{% endif %}>
  {{ forms.autosuggestField({
      label: 'Search Console Site URL'|t('craft-ga'),
      instructions: 'The site URL as registered in Google Search Console (e.g. `https://example.com/`). Leave blank to use the primary site URL.'|t('craft-ga'),
      id: 'searchConsoleSiteUrl',
      name: 'searchConsoleSiteUrl',
      value: settings.searchConsoleSiteUrl,
      suggestEnvVars: true,
  }) }}
</div>

{% js %}
  var $lightswitch = $('#{{ "enableSearchConsole"|namespaceInputId }}');

  $lightswitch.on('change', function() {
    if ($(this).val() == '1') {
      $('#searchConsoleSettings').removeClass('hidden');
    } else {
      $('#searchConsoleSettings').addClass('hidden');
    }
  });

  // The plugin settings template renders inside Craft's settings <form>, so the
  // connect/disconnect actions can't use nested forms. Build a standalone POST
  // form (with CSRF token) on the fly and submit it to the action endpoint.
  $('[data-analytics-action]').on('click', function() {
    var confirmMsg = $(this).data('analytics-confirm');
    if (confirmMsg && !confirm(confirmMsg)) {
      return;
    }

    $('<form/>', {method: 'post', action: Craft.getActionUrl($(this).data('analytics-action'))})
      .append($('<input/>', {type: 'hidden', name: Craft.csrfTokenName, value: Craft.csrfTokenValue}))
      .appendTo(Garnish.$bod)
      .submit();
  });
{% endjs %}

<hr>

<h2>{{ 'Google OAuth2'|t('craft-ga') }}</h2>

{{ forms.autosuggestField({
    label: 'OAuth Client ID'|t('craft-ga'),
    instructions: 'From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.'|t('craft-ga'),
    id: 'oauthClientId',
    name: 'oauthClientId',
    value: settings.oauthClientId,
    suggestEnvVars: true,
    required: true,
}) }}

{{ forms.autosuggestField({
    label: 'OAuth Client Secret'|t('craft-ga'),
    instructions: 'The client secret for the OAuth 2.0 client.'|t('craft-ga'),
    id: 'oauthClientSecret',
    name: 'oauthClientSecret',
    value: settings.oauthClientSecret,
    suggestEnvVars: true,
    required: true,
}) }}

{% set redirectUri = craft.app.plugins.getPlugin('craft-ga').analytics.getRedirectUri() %}
<div class="field">
    <div class="heading">
        <label>{{ 'Authorized Redirect URI'|t('craft-ga') }}</label>
        <div class="instructions"><p>{{ 'Add this URI to your Google OAuth client\'s **Authorized redirect URIs**.'|t('craft-ga') }}</p></div>
    </div>
    <div class="input">
        <code style="padding: 8px 12px; background: #f1f5f9; border-radius: 4px; display: inline-block; user-select: all;">{{ redirectUri }}</code>
    </div>
</div>

{% set envName = settings.getRefreshTokenEnvName() %}

{% if pendingRefreshToken ?? null %}
    {# Shown once, right after the OAuth callback. The plugin does not keep a copy. #}
    <div class="pane" style="border-left: 4px solid #f59e0b; margin-bottom: 24px;">
        <h3 style="margin-top: 0;">{{ 'Finish connecting: add the refresh token to your .env file'|t('craft-ga') }}</h3>
        <p>{{ 'Google issued a refresh token. It is shown only once and is not stored by the plugin. Add this line to the `.env` file of every environment that should be connected, then reload this page.'|t('craft-ga')|md }}</p>
        <pre style="padding: 12px; background: #f1f5f9; border-radius: 4px; overflow-x: auto; user-select: all;">{{ envName }}="{{ pendingRefreshToken }}"</pre>
        <p class="light">{{ 'If you lose this token, disconnect and connect again to get a new one.'|t('craft-ga') }}</p>
    </div>
{% endif %}

{{ forms.autosuggestField({
    label: 'OAuth Refresh Token'|t('craft-ga'),
    instructions: 'Reference to the environment variable holding the refresh token issued by **Connect to Google**, e.g. `$GA4_OAUTH_REFRESH_TOKEN`. Keep the token itself in `.env` so it stays out of project config.'|t('craft-ga'),
    id: 'oauthRefreshToken',
    name: 'oauthRefreshToken',
    value: settings.oauthRefreshToken,
    suggestEnvVars: true,
    placeholder: '$' ~ envName,
}) }}

{% if settings.oauthRefreshToken and not settings.isRefreshTokenEnvReference() %}
    {# Literal token left over from an earlier version: it lives in project config and must move to .env. #}
    <div class="pane" style="border-left: 4px solid #ef4444; margin-bottom: 24px;">
        <h3 style="margin-top: 0;">{{ 'This refresh token is stored in project config'|t('craft-ga') }}</h3>
        <p>{{ 'Move it to your `.env` file and replace the field above with the variable reference, so the secret is no longer committed with `config/project/`.'|t('craft-ga')|md }}</p>
        <pre style="padding: 12px; background: #f1f5f9; border-radius: 4px; overflow-x: auto; user-select: all;">{{ envName }}="{{ settings.oauthRefreshToken }}"</pre>
        <p class="light">{{ 'Then set the field above to:'|t('craft-ga') }} <code>${{ envName }}</code></p>
    </div>
{% endif %}

<hr>

<h2>{{ 'Connection Status'|t('craft-ga') }}</h2>

{% if settings.isConnected() %}
    <div class="field">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #dcfce7; color: #166534; border-radius: 6px; font-weight: 500;">
                <span style="width: 8px; height: 8px; background: #22c55e; border-radius: 50%; display: inline-block;"></span>
                {{ 'Connected to Google Analytics'|t('craft-ga') }}
            </span>
            <button type="button" class="btn small" data-analytics-action="craft-ga/analytics/disconnect" data-analytics-confirm="{{ 'Disconnect from Google Analytics?'|t('craft-ga')|e('html_attr') }}">{{ 'Disconnect'|t('craft-ga') }}</button>
            {% if settings.isRefreshTokenEnvReference() %}
                <span class="light">{{ 'Disconnecting clears the cache; remove `{env}` from .env to revoke the connection in this environment.'|t('craft-ga', { env: envName })|md(inlineOnly=true) }}</span>
            {% endif %}
        </div>
    </div>
{% else %}
    <div class="field">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #fef3c7; color: #92400e; border-radius: 6px; font-weight: 500;">
                <span style="width: 8px; height: 8px; background: #f59e0b; border-radius: 50%; display: inline-block;"></span>
                {{ 'Not connected'|t('craft-ga') }}
            </span>
            {% if settings.oauthRefreshToken and settings.isRefreshTokenEnvReference() %}
                <span class="light">{{ 'The environment variable `{env}` is not set in this environment.'|t('craft-ga', { env: envName })|md(inlineOnly=true) }}</span>
            {% endif %}
            {% if settings.oauthClientId and settings.oauthClientSecret %}
                <button type="button" class="btn submit" data-analytics-action="craft-ga/analytics/connect">{{ 'Connect to Google'|t('craft-ga') }}</button>
            {% else %}
                <span class="light">{{ 'Save your Client ID and Secret first, then connect.'|t('craft-ga') }}</span>
            {% endif %}
        </div>
    </div>
{% endif %}

<hr>

{{ forms.textField({
    label: 'Cache Duration (seconds)'|t('craft-ga'),
    instructions: 'How long to cache API responses, in seconds (minimum 1). Default: 300 (5 minutes).'|t('craft-ga'),
    id: 'cacheDuration',
    name: 'cacheDuration',
    value: settings.cacheDuration,
    type: 'number',
    min: 1,
    size: 10,
}) }}
